{
  "name": "Core Secrets & Credentials",
  "description": "High-confidence detection of API keys, private keys, cloud tokens, SSH files, and system keychains.",
  "version": 2,
  "rules": [
    {
      "id": "secrets_github",
      "tier": "global",
      "action": "block",
      "description": "GitHub Personal Access Tokens (classic, fine-grained, OAuth)",
      "pattern": "(?:ghp_[0-9a-zA-Z]{36}|gho_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{22,})"
    },
    {
      "id": "secrets_anthropic",
      "tier": "global",
      "action": "block",
      "description": "Anthropic API Keys",
      "pattern": "sk-ant-[0-9a-zA-Z\\-_]{20,}"
    },
    {
      "id": "secrets_openai",
      "tier": "global",
      "action": "block",
      "description": "OpenAI / OpenRouter API Keys",
      "pattern": "\\bsk-[0-9a-zA-Z]{32,}\\b"
    },
    {
      "id": "secrets_stripe",
      "tier": "global",
      "action": "block",
      "description": "Stripe Live Secret Keys",
      "pattern": "sk_live_[0-9a-zA-Z]{24,99}"
    },
    {
      "id": "secrets_aws",
      "tier": "global",
      "action": "block",
      "description": "AWS Access Key IDs",
      "pattern": "AKIA[0-9A-Z]{16}"
    },
    {
      "id": "secrets_slack",
      "tier": "global",
      "action": "block",
      "description": "Slack API Bot and User Tokens",
      "pattern": "xox[baprs]-[0-9a-zA-Z]{10,48}"
    },
    {
      "id": "secrets_private_key",
      "tier": "global",
      "action": "block",
      "description": "PEM / OpenSSH / Encrypted Private Key Headers",
      "pattern": "-----BEGIN (?:RSA |OPENSSH |EC |DSA |ENCRYPTED )?PRIVATE KEY-----"
    },
    {
      "id": "cmd_self_approval_tamper",
      "tier": "command",
      "action": "block",
      "description": "Agent attempting to mint its own approval receipt via the CLI or mint_receipt() (tripwire; same-user code can still mint, see limitations.md)",
      "pattern": "\\bapproval_gate(?:\\.py)?\\s+mint\\b|\\bmint_receipt\\s*\\(|\\bguardrails(?:\\.py)?\\b[^;&|]*\\s+approve\\b|(?:^|\\s)approve\\b[^;&|]*\\s--scope\\b"
    },
    {
      "id": "cmd_ssh_credentials",
      "tier": "command",
      "action": "block",
      "description": "Access to SSH directory or private keys via command line (allowing known_hosts)",
      "pattern": "(?:\\b|/)\\.ssh/(?!known_hosts)[a-zA-Z0-9_.-]+|\\bid_rsa\\b|\\bid_ed25519\\b|\\bid_ecdsa\\b|\\bid_dsa\\b"
    },
    {
      "id": "cmd_cloud_credentials",
      "tier": "command",
      "action": "block",
      "description": "Access to AWS config, GCP service accounts, or default credentials",
      "pattern": "(?:^|[\\s'\"`/~=])\\.aws(?:\\b|/)|application_default_credentials|\\bcredentials\\.json\\b|\\bserviceAccount\\w*\\.json\\b"
    },
    {
      "id": "cmd_dotenv_access",
      "tier": "command",
      "action": "block",
      "description": "Reading live .env files via shell commands (allowing templates like .env.example)",
      "pattern": "(?<![a-zA-Z0-9_.-])\\.env(?:\\.(?!example|template|sample|dist)[a-zA-Z0-9_-]+|\\b)(?!\\.(?:example|template|sample|dist))"
    },
    {
      "id": "cmd_gh_hosts",
      "tier": "command",
      "action": "block",
      "description": "Reading GitHub CLI authentication host configurations",
      "pattern": "gh/hosts\\.yml"
    },
    {
      "id": "cmd_keychain",
      "tier": "command",
      "action": "block",
      "description": "Querying passwords from macOS keychain via security CLI",
      "pattern": "\\bsecurity\\s+find-(?:generic|internet)-password\\b"
    }
  ]
}
